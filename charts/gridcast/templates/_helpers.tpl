{{/* Standard labels, applied to every resource of the release. */}}
{{- define "gridcast.labels" -}}
app.kubernetes.io/name: gridcast
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/version: {{ .Values.image.tag | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version }}
{{- end }}

{{/* Full image reference for a component. Fails the install if no tag is given. */}}
{{- define "gridcast.image" -}}
{{ .root.Values.image.registry }}/gridcast-{{ .component }}:{{ required "image.tag is required" .root.Values.image.tag }}
{{- end }}

{{/* Secret created by CloudNativePG with the application credentials and URI. */}}
{{- define "gridcast.dbSecret" -}}
{{ .Release.Name }}-db-app
{{- end }}

{{/* Database URL read from the secret generated by CloudNativePG. */}}
{{- define "gridcast.dbEnv" -}}
- name: GRIDCAST_DATABASE_URL
  valueFrom:
    secretKeyRef:
      name: {{ include "gridcast.dbSecret" . }}
      key: uri
{{- end }}

{{/* Pod level: never root, with the numeric user baked into the images. */}}
{{- define "gridcast.podSecurityContext" -}}
runAsNonRoot: true
runAsUser: 10001
runAsGroup: 10001
seccompProfile:
  type: RuntimeDefault
{{- end }}

{{/* Container level: no privilege escalation, no Linux capabilities, read-only filesystem. */}}
{{- define "gridcast.containerSecurityContext" -}}
allowPrivilegeEscalation: false
readOnlyRootFilesystem: true
capabilities:
  drop: ["ALL"]
{{- end }}
